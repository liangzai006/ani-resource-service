+		if errors.Is(e,os.ErrExist) {
+			prior,readErr:=t.private(name); if readErr!=nil || !bytes.Equal(prior,b) { return nil,errors.New("CONTROL_EXISTING_SIGNAL_INVALID") }
+		} else {
+			if e!=nil { return nil,errors.New("CONTROL_SIGNAL_CREATE_FAILED") }
