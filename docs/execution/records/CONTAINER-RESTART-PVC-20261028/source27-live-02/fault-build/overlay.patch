+}
+func taskKubeFault(c *rest.Config, client string) error {
+	if os.Getenv("ANI_GOAL_KUBE_FAULT_DIR")=="" { return nil }
+	dir,err:=goalFaultDirectoryReady(); if err!=nil { return err }
+	host, err := url.Parse(c.Host)
+	if err!=nil || host.Scheme!="https" || host.Host=="" { return errors.New("task fault requires unchanged HTTPS endpoint") }
+	prev := c.WrapTransport
+	c.WrapTransport = func(rt http.RoundTripper) http.RoundTripper {
+		if prev!=nil { rt=prev(rt) }
+		return &goalFaultTransport{next:rt,dir:dir,client:client,authority:host.Host}
+	}
+	return nil
+}
+
+// This task-tag CLI exits before main; it opens no listener and calls no API.
+// Syntax: /ani-resource-service goal-kube-fault-control arm < plan.json
+//         /ani-resource-service goal-kube-fault-control release|cancel|events NONCE
+//         /ani-resource-service goal-kube-fault-control clear-arm
+func init() {
+	if len(os.Args)<2 || os.Args[1]!="goal-kube-fault-control" { return }
+	result,err:=goalFaultControl(os.Args[2:]); code:=0
+	if err!=nil { result=map[string]any{"result":"CONTROL_FAILED","code":err.Error()}; code=2 }
+	_ = json.NewEncoder(os.Stdout).Encode(result)
+	os.Exit(code)
+}
+func goalFaultControl(args []string) (map[string]any,error) {
