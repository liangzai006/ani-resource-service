+	if p.Client=="storage" { return p.Resource=="persistentvolumeclaims" && p.Method=="DELETE" && p.IntentVersion=="" && p.Stopped=="" && p.InstanceID=="" }
+	if p.Client!="instance" { return false }
+	if p.Resource=="pods" { return p.Method=="GET" && p.InstanceID!="" && p.Mode!="late-forward" && p.IntentVersion=="" && p.Stopped=="" }
+	v,e:=strconv.ParseInt(p.IntentVersion,10,64)
+	return p.Resource=="notebooks" && p.Method=="PUT" && e==nil && v>0 && (p.Stopped=="true" || p.Stopped=="false")
+}
+func (t *goalFaultTransport) private(name string) ([]byte,error) {
+	f,e:=os.OpenFile(filepath.Join(t.dir,name),os.O_RDONLY|syscall.O_NOFOLLOW,0)
+	if e!=nil { return nil,e }; defer f.Close()
+	st,e:=f.Stat(); if e!=nil { return nil,e }; u,ok:=st.Sys().(*syscall.Stat_t)
+	if !ok || !st.Mode().IsRegular() || st.Mode().Perm()!=0600 || u.Uid!=uint32(os.Geteuid()) || st.Size()>8192 { return nil,errors.New("invalid task control file") }
+	return io.ReadAll(io.LimitReader(f,8193))
+}
+func (t *goalFaultTransport) event(p goalFaultPlan, suffix string, v map[string]any) error {
+	v["at"]=time.Now().UTC().Format(time.RFC3339Nano); v["mode"]=p.Mode; v["nonce"]=p.Nonce
+	b,e:=json.Marshal(v); if e!=nil { return e }
