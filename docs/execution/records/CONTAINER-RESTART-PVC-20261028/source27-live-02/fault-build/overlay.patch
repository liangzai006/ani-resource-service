+		return fail()
+	}
+}
+func goalFaultArmValid(p goalFaultPlan) bool {
+	if !goalFaultID.MatchString(p.Nonce) || !goalFaultID.MatchString(p.Namespace) || !goalFaultID.MatchString(p.Name) || p.UID=="" || p.MaxWaitSeconds<1 || p.MaxWaitSeconds>120 { return false }
