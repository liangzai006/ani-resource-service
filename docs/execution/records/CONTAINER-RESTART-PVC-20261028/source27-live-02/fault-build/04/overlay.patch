+		if e!=nil || closeErr!=nil { return nil,errors.New("CONTROL_ATOMIC_WRITE_FAILED") }
+		if e=os.Rename(tmp,filepath.Join(dir,"arm.json")); e!=nil { return nil,errors.New("CONTROL_ATOMIC_RENAME_FAILED") }
+		return map[string]any{"result":"ARMED","nonce":plan.Nonce},nil
+	case "release","cancel":
+		if len(args)!=2 || !goalFaultID.MatchString(args[1]) { return fail() }
+		name:=args[1]+"."+args[0]; b:=[]byte(args[1]+"\n")
+		f,e:=os.OpenFile(filepath.Join(dir,name),os.O_WRONLY|os.O_CREATE|os.O_EXCL|syscall.O_NOFOLLOW,0600)
+		if errors.Is(e,os.ErrExist) {
+			prior,readErr:=t.private(name); if readErr!=nil || !bytes.Equal(prior,b) { return nil,errors.New("CONTROL_EXISTING_SIGNAL_INVALID") }
+		} else {
+			if e!=nil { return nil,errors.New("CONTROL_SIGNAL_CREATE_FAILED") }
+			_,e=f.Write(b); if e==nil { e=f.Sync() }; closeErr:=f.Close()
+			if e!=nil || closeErr!=nil { return nil,errors.New("CONTROL_SIGNAL_WRITE_FAILED") }
+		}
+		return map[string]any{"result":"SIGNALLED","signal":args[0],"nonce":args[1]},nil
+	case "events":
+		if len(args)!=2 || !goalFaultID.MatchString(args[1]) { return fail() }
+		events:=[]map[string]any{}
+		allowed:=map[string]bool{"at":true,"mode":true,"nonce":true,"event":true,"request_sha256":true,"client":true,"method":true,"resource":true,"namespace":true,"name":true,"uid":true,"http_status":true,"transport_error":true}
+		for _,suffix:=range []string{"hit","forward","real-response","late-result","expired","not-sent","dropped"} {
+			b,e:=t.private(args[1]+"."+suffix+".json"); if errors.Is(e,os.ErrNotExist) { continue }; if e!=nil { return nil,errors.New("CONTROL_EVENT_READ_FAILED") }
+			var raw map[string]any; if json.Unmarshal(b,&raw)!=nil || raw["nonce"]!=args[1] { return nil,errors.New("CONTROL_EVENT_INVALID") }
+			v:=map[string]any{}; for k,x:=range raw { if allowed[k] { v[k]=x } }; events=append(events,v)
+		}
+		return map[string]any{"result":"EVENTS","nonce":args[1],"events":events},nil
+	case "clear-arm":
+		if len(args)!=1 { return fail() }
+		if _,e:=t.private("arm.json"); errors.Is(e,os.ErrNotExist) { return map[string]any{"result":"ARM_CLEARED"},nil } else if e!=nil { return nil,errors.New("CONTROL_ARM_READ_FAILED") }
+		if os.Remove(filepath.Join(dir,"arm.json"))!=nil { return nil,errors.New("CONTROL_ARM_REMOVE_FAILED") }
+		return map[string]any{"result":"ARM_CLEARED"},nil
+	default:
+		return fail()
+	}
+}
+func goalFaultArmValid(p goalFaultPlan) bool {
+	if !goalFaultID.MatchString(p.Nonce) || !goalFaultID.MatchString(p.Namespace) || !goalFaultID.MatchString(p.Name) || p.UID=="" || p.MaxWaitSeconds<1 || p.MaxWaitSeconds>120 { return false }
+	if p.Mode!="before" && p.Mode!="after-hold" && p.Mode!="after-drop" && p.Mode!="late-forward" { return false }
+	if p.Client=="storage" { return p.Resource=="persistentvolumeclaims" && p.Method=="DELETE" && p.IntentVersion=="" && p.Stopped=="" && p.InstanceID=="" }
+	if p.Client!="instance" { return false }
+	if p.Resource=="pods" { return p.Method=="GET" && p.InstanceID!="" && p.Mode!="late-forward" && p.IntentVersion=="" && p.Stopped=="" }
+	v,e:=strconv.ParseInt(p.IntentVersion,10,64)
+	return p.Resource=="notebooks" && p.Method=="PUT" && e==nil && v>0 && (p.Stopped=="true" || p.Stopped=="false")
+}
+func (t *goalFaultTransport) private(name string) ([]byte,error) {
+	f,e:=os.OpenFile(filepath.Join(t.dir,name),os.O_RDONLY|syscall.O_NOFOLLOW,0)
+	if e!=nil { return nil,e }; defer f.Close()
+	st,e:=f.Stat(); if e!=nil { return nil,e }; u,ok:=st.Sys().(*syscall.Stat_t)
+	if !ok || !st.Mode().IsRegular() || st.Mode().Perm()!=0600 || u.Uid!=uint32(os.Geteuid()) || st.Size()>8192 { return nil,errors.New("invalid task control file") }
+	return io.ReadAll(io.LimitReader(f,8193))
+}
+func (t *goalFaultTransport) event(p goalFaultPlan, suffix string, v map[string]any) error {
+	v["at"]=time.Now().UTC().Format(time.RFC3339Nano); v["mode"]=p.Mode; v["nonce"]=p.Nonce
+	b,e:=json.Marshal(v); if e!=nil { return e }
+	f,e:=os.OpenFile(filepath.Join(t.dir,p.Nonce+"."+suffix+".json"),os.O_WRONLY|os.O_CREATE|os.O_EXCL|syscall.O_NOFOLLOW,0600)
+	if e!=nil { return e }; defer f.Close(); _,e=f.Write(append(b,'\n')); return e
+}
+func (t *goalFaultTransport) wait(ctx context.Context,p goalFaultPlan) bool {
+	tick:=time.NewTicker(100*time.Millisecond); defer tick.Stop()
+	for {
+		if b,e:=t.private(p.Nonce+".cancel"); e==nil && string(bytes.TrimSpace(b))==p.Nonce { return false }
+		if b,e:=t.private(p.Nonce+".release"); e==nil && string(bytes.TrimSpace(b))==p.Nonce { return true }
+		select { case <-ctx.Done(): return false; case <-tick.C: }
+	}
+}
+func (t *goalFaultTransport) plan(req *http.Request) (goalFaultPlan,bool) {
+	var p goalFaultPlan
