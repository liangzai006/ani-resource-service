+// GoalStageExitControl is a task-build-only local-file command. It performs no
+// API, PG, service-listener, credential or business operation.
+func GoalStageExitControl(args []string, input io.Reader, output io.Writer) int {
+	fail := func(err error) int { fmt.Fprintln(output, err); return 2 }
+	if len(args) < 1 {
+		return fail(errors.New("usage: arm | events NONCE | clear NONCE"))
+	}
+	if err := goalStageDirectory(true); err != nil {
+		return fail(err)
+	}
+	switch args[0] {
+	case "arm":
+		if len(args) != 1 {
+			return fail(errors.New("arm takes plan JSON on stdin"))
+		}
+		var p goalStagePlan
+		dec := json.NewDecoder(io.LimitReader(input, 65537))
+		dec.DisallowUnknownFields()
+		if err := dec.Decode(&p); err != nil {
+			return fail(err)
+		}
+		if err := dec.Decode(new(any)); err != io.EOF {
+			return fail(errors.New("trailing plan input"))
+		}
+		if err := goalStageValidate(p); err != nil {
+			return fail(err)
+		}
+		if _, err := os.Lstat(filepath.Join(goalStageDir, "arm.json")); err == nil || !os.IsNotExist(err) {
+			return fail(errors.New("clear HTTP fault arm before stage arm"))
+		}
+		names, err := filepath.Glob(filepath.Join(goalStageDir, "stage-exit-"+p.Nonce+".*.json"))
+		if err != nil || len(names) != 0 {
+			return fail(errors.New("nonce already has markers"))
+		}
+		if err = goalStageCreate(goalStageArm, p); err != nil {
+			return fail(err)
+		}
+		fmt.Fprintln(output, "ARMED", p.Nonce, p.Kind)
+		return 0
+	case "events", "clear":
+		if len(args) != 2 || !biz.UUID(args[1]) {
+			return fail(errors.New("explicit UUID nonce required"))
+		}
+		if args[0] == "clear" {
+			var p goalStagePlan
+			if err := goalStageRead(goalStageArm, &p); err != nil {
+				return fail(err)
+			}
+			if p.Nonce != args[1] {
+				return fail(errors.New("armed nonce mismatch"))
+			}
+			if err := os.Remove(filepath.Join(goalStageDir, goalStageArm)); err != nil {
+				return fail(err)
+			}
+			d, err := os.Open(goalStageDir)
+			if err != nil {
+				return fail(err)
+			}
+			err = d.Sync()
+			d.Close()
+			if err != nil {
+				return fail(err)
+			}
+			fmt.Fprintln(output, "CLEARED", p.Nonce)
+			return 0
+		}
+		names, err := filepath.Glob(filepath.Join(goalStageDir, "stage-exit-"+args[1]+".*.json"))
+		if err != nil {
+			return fail(err)
+		}
+		sort.Strings(names)
+		result := []goalStageRecord{}
+		for _, name := range names {
+			var r goalStageRecord
+			if err = goalStageRead(filepath.Base(name), &r); err != nil {
+				return fail(err)
+			}
+			result = append(result, r)
+		}
+		raw, err := json.MarshalIndent(result, "", "  ")
+		if err != nil {
+			return fail(err)
+		}
+		fmt.Fprintln(output, string(raw))
+		return 0
+	default:
+		return fail(errors.New("unknown stage control command"))
+	}
