+// Source27 input: 123e66c0daf6fdd946abada44d3ff9507d5127e4. Apply only
+// in a task build directory or go -overlay mapping, never the source checkout.
+// Task-only diagnostic overlay. Disabled unless compiled with ani_goal_kubefault
+// AND ANI_GOAL_KUBE_FAULT_DIR=/run/ani-goal-kube-fault/control. The Pod
+// mounts only the emptyDir parent; the actual UID creates an owned 0700 child. arm.json and
+// <nonce>.release / <nonce>.cancel are owned 0600 files containing the nonce.
+// arm.json is atomically replaced; cancel also stops a queued late write.
+// Never enable on a shared worker: only the separately scoped diagnostic process.
+//
+// Arm fields: nonce,client(instance|storage),namespace,name,uid,method(PUT|DELETE),
+// resource(notebooks|persistentvolumeclaims|pods),instance_id,intent_version,stopped(true|false),
+// mode(before|after-hold|after-drop|late-forward),max_wait_seconds(1..120).
+// Notebook PUT requires the exact UID plus a nonempty original RV and mutation
+// annotation. PVC DELETE requires exact DeleteOptions.preconditions.uid.
+// No POST/CREATE, PATCH, arbitrary GET/LIST, subresource, credential or body logging.
+// The sole LIST exception is exact namespace Pod LIST carrying the explicit
+// ObserveIdentity task context: instanceID/namespace/NotebookName/NotebookUID.
+// Its real request is gated/forwarded unchanged; no response object is fabricated.
+// No fabricated empty lists, deleted labels, terminating Pods or STS status.
+// PG-only reserve/usage/config-commit boundaries likewise need a separate hook.
+//
+// before: hit -> wait release using ORIGINAL context -> forward unchanged.
+// after-hold: real write -> response marker -> hold original response; cancellation
+//             or process exit loses the reply while the real write is preserved.
+// after-drop: real write and actual 2xx -> drain/close -> injected EOF to caller.
+// late-forward: freeze exact original bytes/UID/RV, queue beyond caller cancellation
+//               under independent bounded context; release sends it ONCE. This is
+//               intentional delayed delivery, not a new intent or refreshed CAS.
+//               Queue dies on process exit; expiry explicitly records NOT_SENT.
+// For A15, late-forward stopped=false and pass stopped=true fence, or rearm a
+// distinct nonce for after-drop stopped=true. Release original before/after actual
+// fence evidence as chosen by Root. Missing release never forwards after TTL.
+// Markers prove observed transport order only, not Kubernetes/controller outcome.
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"syscall"
+	"time"
+
+	"k8s.io/client-go/rest"
+)
