+
+func goalStageValidate(p goalStagePlan) error {
+	if !biz.UUID(p.Nonce) || p.TenantID != goalStageTenant || p.ClusterID != goalStageCluster || p.Namespace != goalStageNamespace || !p.ExpiresAt.After(time.Now()) || p.ExpiresAt.After(time.Now().Add(2*time.Hour)) {
+		return errors.New("stage plan identity or expiry invalid")
+	}
+	switch p.Kind {
+	case "instance-attach-seven":
+		if !biz.UUID(p.InstanceID) || p.IntentVersion < 2 || p.Action != "attach-pvc" || p.PVCName != "" || p.PVCUID != "" {
+			return errors.New("stage instance plan invalid")
+		}
+	case "storage-reserve", "storage-mark":
+		if p.InstanceID != "" || p.IntentVersion != 0 || p.Action != "" || p.PVCName == "" || filepath.Base(p.PVCName) != p.PVCName || !biz.UUID(p.PVCUID) {
+			return errors.New("stage storage plan invalid")
+		}
+	default:
+		return errors.New("stage plan kind invalid")
+	}
+	return nil
+}
+
+func goalStageDirectory(create bool) error {
+	if os.Getenv("ANI_GOAL_KUBE_FAULT_DIR") != goalStageDir {
+		return errors.New("stage control disabled")
+	}
+	parent, err := os.Lstat(filepath.Dir(goalStageDir))
+	if err != nil || !parent.IsDir() || parent.Mode()&os.ModeSymlink != 0 {
+		return errors.New("stage parent invalid")
+	}
+	if create {
+		if err = os.Mkdir(goalStageDir, 0700); err != nil && !os.IsExist(err) {
+			return err
+		}
+	}
+	st, err := os.Lstat(goalStageDir)
+	if err != nil {
+		return err
+	}
+	sys, ok := st.Sys().(*syscall.Stat_t)
+	if !ok || !st.IsDir() || st.Mode()&os.ModeSymlink != 0 || st.Mode().Perm() != 0700 || int(sys.Uid) != os.Geteuid() {
+		return errors.New("stage directory owner or mode invalid")
+	}
+	return nil
+}
+
+func goalStageRead(name string, out any) error {
+	if filepath.Base(name) != name {
+		return errors.New("stage filename invalid")
+	}
+	f, err := os.OpenFile(filepath.Join(goalStageDir, name), os.O_RDONLY|syscall.O_NOFOLLOW, 0)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	st, err := f.Stat()
+	if err != nil {
+		return err
+	}
+	sys, ok := st.Sys().(*syscall.Stat_t)
+	if !ok || !st.Mode().IsRegular() || st.Mode().Perm() != 0600 || int(sys.Uid) != os.Geteuid() || st.Size() > 65536 {
+		return errors.New("stage file owner, mode or size invalid")
+	}
+	dec := json.NewDecoder(io.LimitReader(f, 65537))
+	dec.DisallowUnknownFields()
+	if err = dec.Decode(out); err != nil {
+		return err
+	}
+	if err = dec.Decode(new(any)); err != io.EOF {
+		return errors.New("stage trailing input")
+	}
+	return nil
+}
+
+func goalStageCreate(name string, value any) error {
+	raw, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		return err
+	}
+	if len(raw) > 65535 || filepath.Base(name) != name {
+		return errors.New("stage marker invalid")
+	}
+	f, err := os.OpenFile(filepath.Join(goalStageDir, name), os.O_WRONLY|os.O_CREATE|os.O_EXCL|syscall.O_NOFOLLOW, 0600)
+	if err != nil {
+		return err
+	}
+	if err = f.Chmod(0600); err != nil {
+		f.Close()
+		return err
+	}
+	if _, err = f.Write(append(raw, '\n')); err != nil {
+		f.Close()
+		return err
+	}
+	if err = f.Sync(); err != nil {
+		f.Close()
+		return err
+	}
+	if err = f.Close(); err != nil {
+		return err
+	}
+	d, err := os.Open(goalStageDir)
+	if err != nil {
+		return err
+	}
+	defer d.Close()
+	return d.Sync()
+}
+
+func goalStageLoad() (goalStagePlan, bool) {
+	var p goalStagePlan
+	if goalStageDirectory(false) != nil || goalStageRead(goalStageArm, &p) != nil || goalStageValidate(p) != nil {
+		return p, false
+	}
+	return p, true
+}
+
+func goalStageName(p goalStagePlan, point string) string {
+	return "stage-exit-" + p.Nonce + "." + point + ".json"
+}
+
+func goalStageSame(r goalStageRecord, p goalStagePlan, op string) bool {
+	if r.Schema != 1 || r.Nonce != p.Nonce || r.Kind != p.Kind || r.TenantID != p.TenantID || r.ClusterID != p.ClusterID || r.Namespace != p.Namespace || r.ExitCode != goalStageExitCode {
+		return false
+	}
+	if p.Kind == "instance-attach-seven" {
+		return r.InstanceID == p.InstanceID && r.OperationID == op && r.Action == p.Action && r.IntentVersion == p.IntentVersion
+	}
+	return r.DeleteIdentity != nil && r.DeleteIdentity.TenantID == p.TenantID && r.DeleteIdentity.ClusterID == p.ClusterID && r.DeleteIdentity.Namespace == p.Namespace && r.DeleteIdentity.PVCName == p.PVCName && r.DeleteIdentity.TargetUID == p.PVCUID
+}
+
+func goalStageExit(p goalStagePlan, r goalStageRecord) {
+	if !p.ExpiresAt.After(time.Now()) {
+		return
+	}
+	points := []string{r.Point}
+	if p.Kind == "instance-attach-seven" {
+		points = goalStagePoints
+	}
+	index := -1
+	for k, point := range points {
+		if point == r.Point {
+			index = k
+		}
+	}
+	if index < 0 {
+		return
+	}
+	for k, point := range points {
+		var old goalStageRecord
+		err := goalStageRead(goalStageName(p, point), &old)
+		if k < index {
+			if err != nil || old.Point != point || !goalStageSame(old, p, r.OperationID) {
+				fmt.Fprintln(os.Stderr, "goal stage exit: prior marker invalid; injection not performed")
+				return
+			}
+		} else if err == nil {
+			if k == index && old.Point == point && goalStageSame(old, p, r.OperationID) {
+				return
+			}
+			fmt.Fprintln(os.Stderr, "goal stage exit: marker sequence conflict; injection not performed")
+			return
+		} else if !os.IsNotExist(err) {
+			fmt.Fprintln(os.Stderr, "goal stage exit: marker unreadable; injection not performed")
+			return
+		}
+	}
+	if err := goalStageCreate(goalStageName(p, r.Point), r); err != nil {
+		fmt.Fprintln(os.Stderr, "goal stage exit: marker not durable; injection not performed")
+		return
+	}
+	os.Exit(goalStageExitCode)
+}
