+type goalFaultPlan struct {
+	Nonce string `json:"nonce"`
+	Client string `json:"client"`
+	Namespace string `json:"namespace"`
+	Name string `json:"name"`
+	UID string `json:"uid"`
+	InstanceID string `json:"instance_id"`
+	Method string `json:"method"`
+	Resource string `json:"resource"`
+	IntentVersion string `json:"intent_version"`
+	Stopped string `json:"stopped"`
+	Mode string `json:"mode"`
+	MaxWaitSeconds int `json:"max_wait_seconds"`
+}
+type goalFaultTransport struct { next http.RoundTripper; dir, client, authority string }
+var goalFaultID = regexp.MustCompile(`^[a-z0-9][a-z0-9-]{0,62}$`)
+
+const goalFaultParent = "/run/ani-goal-kube-fault"
+const goalFaultDirectory = goalFaultParent+"/control"
+
+func goalFaultDirectoryReady() (string,error) {
+	if os.Getenv("ANI_GOAL_KUBE_FAULT_DIR")!=goalFaultDirectory { return "",errors.New("TASK_CONTROL_DIRECTORY_NOT_FIXED") }
+	parent,e:=os.Lstat(goalFaultParent)
+	if e!=nil || !parent.IsDir() || parent.Mode()&os.ModeSymlink!=0 { return "",errors.New("TASK_EMPTYDIR_PARENT_REQUIRED") }
+	// The Pod fsGroup supplies parent write permission. The actual service UID
+	// owns its newly created child; neither OCI UID nor root is hardcoded.
+	if e=os.Mkdir(goalFaultDirectory,0700); e!=nil && !errors.Is(e,os.ErrExist) { return "",errors.New("TASK_CONTROL_DIRECTORY_CREATE_FAILED") }
