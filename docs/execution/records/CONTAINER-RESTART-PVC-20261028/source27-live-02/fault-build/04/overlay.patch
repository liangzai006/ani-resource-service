+		// never exposes a partially written arm. Temporary basename is internal.
+		b,e=json.Marshal(plan); if e!=nil { return nil,errors.New("CONTROL_PLAN_ENCODE_FAILED") }
+		f,e:=os.CreateTemp(dir,".arm-"); if e!=nil { return nil,errors.New("CONTROL_ATOMIC_CREATE_FAILED") }
+		tmp:=f.Name(); defer os.Remove(tmp)
