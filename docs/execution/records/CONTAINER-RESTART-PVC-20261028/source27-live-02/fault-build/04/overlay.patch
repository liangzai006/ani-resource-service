+		v,e:=strconv.ParseInt(p.IntentVersion,10,64); if e!=nil || v<=0 || (p.Stopped!="true" && p.Stopped!="false") { return p,false }
+	} else if !(p.Client=="storage" && p.Resource=="persistentvolumeclaims" && p.Method=="DELETE") { return p,false }
