+	d:=json.NewDecoder(bytes.NewReader(b)); d.DisallowUnknownFields()
+	if d.Decode(&p)!=nil || d.Decode(new(any))!=io.EOF { return p,false }
+	if !goalFaultArmValid(p) || p.Client!=t.client { return p,false }
+	if p.Mode!="before" && p.Mode!="after-hold" && p.Mode!="after-drop" && p.Mode!="late-forward" { return p,false }
+	if req.URL.Scheme!="https" || req.URL.Host!=t.authority || req.Method!=p.Method { return p,false }
